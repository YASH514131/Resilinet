# Copy this to .env and fill in your values
# Never commit .env to version control

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Path where evidence screenshots are saved
EVIDENCE_DIR=./evidence_screenshots

# Camera source: use 0 for webcam, or an RTSP URL string
# Examples:
#   CAMERA_SOURCE=0
#   CAMERA_SOURCE=rtsp://admin:password@192.168.1.64:554/stream
CAMERA_SOURCE=./accident.mp4
CAMERA_ID=cam-001
CAMERA_NAME=Test Camera 1

# YOLO detection confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.69
